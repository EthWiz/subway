        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: value, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|onClick|onRemove|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, selected, onClick, onRemove, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TokenMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:ticker|name|hedged|size|style|key|ref|className|style|children)$/]",
        "message": "<TokenMark> doesn't accept that prop. Declared props: ticker, name, hedged, size, style."
